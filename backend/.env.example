# ==============================================================================
# SkillBit - AI Resume Builder, ATS Job Matcher & Job Discovery Engine (.env.example)
# ==============================================================================

# 1. Core Application & Security
SECRET_KEY=replace_with_strong_random_jwt_secret_key
DATABASE_URL=sqlite:///./app.db

# 2. Multi-Provider LLM Failover Orchestration (Optional - Local Fallback Active by Default)
DEFAULT_LLM_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=

# 3. AI Job Discovery & Multi-Source Search Integrations
ENABLE_LIVE_JOB_DISCOVERY=true
JOB_SEARCH_TIMEOUT_SECONDS=6.0
JOB_SEARCH_RATE_LIMIT_RPM=30

# Optional Search & Portal Provider Keys (Required only for gated portals; public APIs work zero-key)
JSEARCH_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FINDWORK_API_KEY=
X_BEARER_TOKEN=

# 4. Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 5. SMTP Email Notifications (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SkillBit
SMTP_USE_TLS=true
